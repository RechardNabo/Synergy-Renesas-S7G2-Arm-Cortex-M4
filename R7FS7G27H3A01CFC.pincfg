<?xml version="1.0" encoding="utf-8"?>
<v1:pinSettings xmlns:v1="http://www.tasking.com/schema/pinsettings/v1.1">
  <v1:pinMappingsRef version="2.05" file="" />
  <v1:deviceSetting id="renesas.s7g2_fc" pattern="R7FS7G2*******FC">
    <v1:packageSetting id="renesas.176lqfp" />
  </v1:deviceSetting>
  <!-- Debug: SWD mode (frees P110/P111 for GLCD) -->
  <v1:configSetting configurationId="debug0.mode" altId="debug0.mode.swd" />
  <v1:configSetting configurationId="debug0.swdio" altId="debug0.swdio.p108">
    <v1:connectionSetting altId="p108.debug0.swdio" />
  </v1:configSetting>
  <v1:configSetting configurationId="debug0.swclk" altId="debug0.swclk.p300">
    <v1:connectionSetting altId="p300.debug0.swclk" />
  </v1:configSetting>
  <v1:configSetting configurationId="p108.gpio_mode" altId="p108.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p108" altId="p108.debug0.swdio">
    <v1:connectionSetting altId="debug0.swdio.p108" />
  </v1:configSetting>
  <v1:configSetting configurationId="p300.gpio_mode" altId="p300.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p300" altId="p300.debug0.swclk">
    <v1:connectionSetting altId="debug0.swclk.p300" />
  </v1:configSetting>
  <!-- LED1 (Red) - P305 active low -->
  <v1:configSetting configurationId="p305.gpio_mode" altId="p305.gpio_mode.gpio_mode_out.low" />
  <v1:configSetting configurationId="p305" altId="p305.output.low" />
  <!-- LED2 (Green) - P801 active high -->
  <v1:configSetting configurationId="p801.gpio_mode" altId="p801.gpio_mode.gpio_mode_out.high" />
  <v1:configSetting configurationId="p801" altId="p801.output.high" />
  <!-- USB Host VBUS enable - Pb00 -->
  <v1:configSetting configurationId="pb00.gpio_mode" altId="pb00.gpio_mode.gpio_mode_out.high" />
  <v1:configSetting configurationId="pb00" altId="pb00.output.high" />
  <!-- USB Host VBUS monitor - Pb01 -->
  <v1:configSetting configurationId="pb01.gpio_mode" altId="pb01.gpio_mode.gpio_mode_in" />
  <v1:configSetting configurationId="pb01" altId="pb01.input" />
  <!-- USB Host fault monitor - P415 -->
  <v1:configSetting configurationId="p415.gpio_mode" altId="p415.gpio_mode.gpio_mode_in" />
  <v1:configSetting configurationId="p415" altId="p415.input" />
  <!-- ADC0 - P000 = AN00 (potentiometer) -->
  <v1:configSetting configurationId="adc0.mode" altId="adc0.mode.custom" />
  <v1:configSetting configurationId="adc0.an00" altId="adc0.an00.p000" />
  <v1:configSetting configurationId="p000.gpio_mode" altId="p000.gpio_mode.gpio_mode_an" />
  <v1:configSetting configurationId="p000" altId="p000.asel">
    <v1:connectionSetting altId="adc0.an00.p000" />
  </v1:configSetting>
  <!-- ADC1 - P006 = AN02 (vibration sensor) -->
  <v1:configSetting configurationId="adc1.mode" altId="adc1.mode.custom" />
  <v1:configSetting configurationId="adc1.an02" altId="adc1.an02.p006" />
  <v1:configSetting configurationId="p006.gpio_mode" altId="p006.gpio_mode.gpio_mode_an" />
  <v1:configSetting configurationId="p006" altId="p006.asel">
    <v1:connectionSetting altId="adc1.an02.p006" />
  </v1:configSetting>
  <!-- GLCDC0 - Graphics LCD data pins (only P111-P115 available without conflicts) -->
  <v1:configSetting configurationId="glcdc0.mode" altId="glcdc0.mode.custom.free" />
  <v1:configSetting configurationId="glcdc0.lcd_data08" altId="glcdc0.lcd_data08.p115" />
  <v1:configSetting configurationId="glcdc0.lcd_data09" altId="glcdc0.lcd_data09.p114" />
  <v1:configSetting configurationId="glcdc0.lcd_data10" altId="glcdc0.lcd_data10.p113" />
  <v1:configSetting configurationId="glcdc0.lcd_data11" altId="glcdc0.lcd_data11.p112" />
  <v1:configSetting configurationId="glcdc0.lcd_data12" altId="glcdc0.lcd_data12.p111" />
  <!-- P111 = GLCDC0 LCD_DATA12 -->
  <v1:configSetting configurationId="p111.gpio_mode" altId="p111.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p111" altId="p111.glcdc0.lcd_data12">
    <v1:connectionSetting altId="glcdc0.lcd_data12.p111" />
  </v1:configSetting>
  <!-- P112 = GLCDC0 LCD_DATA11 -->
  <v1:configSetting configurationId="p112.gpio_mode" altId="p112.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p112" altId="p112.glcdc0.lcd_data11">
    <v1:connectionSetting altId="glcdc0.lcd_data11.p112" />
  </v1:configSetting>
  <!-- P113 = GLCDC0 LCD_DATA10 -->
  <v1:configSetting configurationId="p113.gpio_mode" altId="p113.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p113" altId="p113.glcdc0.lcd_data10">
    <v1:connectionSetting altId="glcdc0.lcd_data10.p113" />
  </v1:configSetting>
  <!-- P114 = GLCDC0 LCD_DATA09 -->
  <v1:configSetting configurationId="p114.gpio_mode" altId="p114.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p114" altId="p114.glcdc0.lcd_data09">
    <v1:connectionSetting altId="glcdc0.lcd_data09.p114" />
  </v1:configSetting>
  <!-- P115 = GLCDC0 LCD_DATA08 -->
  <v1:configSetting configurationId="p115.gpio_mode" altId="p115.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p115" altId="p115.glcdc0.lcd_data08">
    <v1:connectionSetting altId="glcdc0.lcd_data08.p115" />
  </v1:configSetting>
  <!-- PMOD IIC (J18) GPIO pins - P203 (GPIO1), P204 (GPIO2), per README (P202 is NOT part of J18) -->
  <v1:configSetting configurationId="p203.gpio_mode" altId="p203.gpio_mode.gpio_mode_in" />
  <v1:configSetting configurationId="p203" altId="p203.input" />
  <v1:configSetting configurationId="p204.gpio_mode" altId="p204.gpio_mode.gpio_mode_in" />
  <v1:configSetting configurationId="p204" altId="p204.input" />
  <!-- GPT1 PWM output - P405 (GTIOCA) -->
  <v1:configSetting configurationId="gpt1.gtioca" altId="gpt1.gtioca.p405" />
  <v1:configSetting configurationId="gpt1.mode" altId="gpt1.mode.gtiocaorgtiocb.b" />
  <v1:configSetting configurationId="gpt1.pairing" altId="gpt1.pairing.b" />
  <v1:configSetting configurationId="p405.gpio_mode" altId="p405.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p405" altId="p405.gpt1.gtioca">
    <v1:connectionSetting altId="gpt1.gtioca.p405" />
  </v1:configSetting>
  <!-- PMOD SPI (J13) - native SPI0 peripheral (r_rspi), NOT SCI0 (SCI0 is used by PMOD UART below) -->
  <v1:configSetting configurationId="spi0.mode" altId="spi0.mode.custom.free" />
  <v1:configSetting configurationId="spi0.miso" altId="spi0.miso.p100" />
  <v1:configSetting configurationId="spi0.mosi" altId="spi0.mosi.p101" />
  <v1:configSetting configurationId="spi0.rspck" altId="spi0.rspck.p102" />
  <v1:configSetting configurationId="spi0.ssl0" altId="spi0.ssl0.p103" />
  <!-- P100 = SPI0_MISO -->
  <v1:configSetting configurationId="p100.gpio_mode" altId="p100.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p100" altId="p100.spi0.miso">
    <v1:connectionSetting altId="spi0.miso.p100" />
  </v1:configSetting>
  <!-- P101 = SPI0_MOSI -->
  <v1:configSetting configurationId="p101.gpio_mode" altId="p101.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p101" altId="p101.spi0.mosi">
    <v1:connectionSetting altId="spi0.mosi.p101" />
  </v1:configSetting>
  <!-- P102 = SPI0_RSPCK (SCLK) -->
  <v1:configSetting configurationId="p102.gpio_mode" altId="p102.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p102" altId="p102.spi0.rspck">
    <v1:connectionSetting altId="spi0.rspck.p102" />
  </v1:configSetting>
  <!-- P103 = SPI0_SSL0 (SS) -->
  <v1:configSetting configurationId="p103.gpio_mode" altId="p103.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p103" altId="p103.spi0.ssl0">
    <v1:connectionSetting altId="spi0.ssl0.p103" />
  </v1:configSetting>
  <!-- PMOD IIC (J18) - IIC1 channel: r_iic on ch1 -->
  <!-- Enable IIC1 peripheral, pairing group A (P205-P206) -->
  <v1:configSetting configurationId="iic1.mode" altId="iic1.mode.enabled.free" />
  <v1:configSetting configurationId="iic1.pairing" altId="iic1.pairing.a" />
  <v1:configSetting configurationId="iic1.scl" altId="iic1.scl.p205" />
  <v1:configSetting configurationId="iic1.sda" altId="iic1.sda.p206" />
  <!-- P205 = IIC1_SCL -->
  <v1:configSetting configurationId="p205.gpio_mode" altId="p205.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p205" altId="p205.iic1.scl">
    <v1:connectionSetting altId="iic1.scl.p205" />
  </v1:configSetting>
  <!-- P206 = IIC1_SDA -->
  <v1:configSetting configurationId="p206.gpio_mode" altId="p206.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p206" altId="p206.iic1.sda">
    <v1:connectionSetting altId="iic1.sda.p206" />
  </v1:configSetting>
  <!-- USB Device VBUS - P407 (input) -->
  <v1:configSetting configurationId="p407.gpio_mode" altId="p407.gpio_mode.gpio_mode_in" />
  <v1:configSetting configurationId="p407" altId="p407.input" />
  <!-- PMOD UART (J16) IRQ7 - P408 (plain interrupt input, NOT part of SCI0 UART signal path) -->
  <v1:configSetting configurationId="p408.gpio_mode" altId="p408.gpio_mode.gpio_mode_in" />
  <v1:configSetting configurationId="p408" altId="p408.input" />
  <!-- PMOD SPI (J13) IRQ6 - P409 (plain interrupt input) -->
  <v1:configSetting configurationId="p409.gpio_mode" altId="p409.gpio_mode.gpio_mode_in" />
  <v1:configSetting configurationId="p409" altId="p409.input" />
  <!-- PMOD UART (J16) - SCI0 channel, pairing group B (P410-P413) -->
  <v1:configSetting configurationId="sci0.mode" altId="sci0.mode.custom.free" />
  <v1:configSetting configurationId="sci0.pairing" altId="sci0.pairing.b" />
  <v1:configSetting configurationId="sci0.rxd" altId="sci0.rxd.p410" />
  <v1:configSetting configurationId="sci0.txd" altId="sci0.txd.p411" />
  <v1:configSetting configurationId="sci0.sck" altId="sci0.sck.p412" />
  <v1:configSetting configurationId="sci0.cts" altId="sci0.cts.p413" />
  <!-- P410 = SCI0_RXD -->
  <v1:configSetting configurationId="p410.gpio_mode" altId="p410.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p410" altId="p410.sci0.rxd">
    <v1:connectionSetting altId="sci0.rxd.p410" />
  </v1:configSetting>
  <!-- P411 = SCI0_TXD -->
  <v1:configSetting configurationId="p411.gpio_mode" altId="p411.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p411" altId="p411.sci0.txd">
    <v1:connectionSetting altId="sci0.txd.p411" />
  </v1:configSetting>
  <!-- P412 = SCI0_SCK (UART_DTS, optional for synchronous mode) -->
  <v1:configSetting configurationId="p412.gpio_mode" altId="p412.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p412" altId="p412.sci0.sck">
    <v1:connectionSetting altId="sci0.sck.p412" />
  </v1:configSetting>
  <!-- P413 = SCI0_CTS -->
  <v1:configSetting configurationId="p413.gpio_mode" altId="p413.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p413" altId="p413.sci0.cts">
    <v1:connectionSetting altId="sci0.cts.p413" />
  </v1:configSetting>
  <!-- PMOD SPI GPIO pins - P612, P613, P614 (inputs) -->
  <v1:configSetting configurationId="p612.gpio_mode" altId="p612.gpio_mode.gpio_mode_in" />
  <v1:configSetting configurationId="p612" altId="p612.input" />
  <v1:configSetting configurationId="p613.gpio_mode" altId="p613.gpio_mode.gpio_mode_in" />
  <v1:configSetting configurationId="p613" altId="p613.input" />
  <v1:configSetting configurationId="p614.gpio_mode" altId="p614.gpio_mode.gpio_mode_in" />
  <v1:configSetting configurationId="p614" altId="p614.input" />
  <!-- CAN1 Channel B (Arduino header) - external transceiver required -->
  <!-- P512 = CAN1_CTX -->
  <v1:configSetting configurationId="can1.mode" altId="can1.mode.enabled.b" />
  <v1:configSetting configurationId="can1.pairing" altId="can1.pairing.b" />
  <v1:configSetting configurationId="can1.ctx" altId="can1.ctx.p512" />
  <v1:configSetting configurationId="can1.crx" altId="can1.crx.p511" />
  <v1:configSetting configurationId="p512.gpio_mode" altId="p512.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p512" altId="p512.can1.ctx">
    <v1:connectionSetting altId="can1.ctx.p512" />
  </v1:configSetting>
  <!-- P511 = CAN1_CRX -->
  <v1:configSetting configurationId="p511.gpio_mode" altId="p511.gpio_mode.gpio_mode_peripheral" />
  <v1:configSetting configurationId="p511" altId="p511.can1.crx">
    <v1:connectionSetting altId="can1.crx.p511" />
  </v1:configSetting>
</v1:pinSettings>
